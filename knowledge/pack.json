    },
    {
      "idtf": "ui_principle_quick_learning",
      "title_ru": "Принцип быстрого освоения",
      "text_ru": "Основная единица работы — абстрактная модель ПИ: задачи, объекты, события, ограничения; исходный код не обязателен.",
      "source_ru": "Проект, 5.2"
    },
    {
      "idtf": "ui_principle_autonomous_changeability",
      "title_ru": "Принцип автономной изменяемости",
      "text_ru": "Интерфейс меняется на целевой платформе без инструментальной среды по запросу пользователя; изменения выполняются над разрешёнными параметрами, регистрируются и обратимы.",
      "source_ru": "Проект, 5.3"
    },
    {
      "idtf": "ui_principle_reuse",
      "title_ru": "Принцип многократного использования",
      "text_ru": "Интерфейсы и компоненты хранятся в библиотеке как знания о назначении, свойствах и совместимости; поиск идёт и по назначению.",
      "source_ru": "Проект, 5.4"
    },
    {
      "idtf": "ui_principle_semantic_compatibility",
      "title_ru": "Принцип семантической совместимости",
      "text_ru": "Каждый значимый компонент связан со смысловой конструкцией базы знаний и имеет формальную спецификацию: понятия, события, предусловия и постусловия.",
      "source_ru": "Проект, 5.5"
    }
  ],
