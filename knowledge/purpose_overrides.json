{
  "schema_version": 1,
  "note": "Русские назначения типов, смыслы свойств и типы значений. Хранятся отдельно, чтобы не теряться при пересборке pack.",
  "types": {
    "image": {
      "purpose_ru": "Отображает изображение из ресурса в text_value."
    },
    "sound": {
      "purpose_ru": "Воспроизводит звук из ресурса в text_value."
    },
    "text": {
      "purpose_ru": "Статический текст, содержимое в text_value."
    },
    "divider": {
      "purpose_ru": "Разделитель групп элементов; не инициирует действия, action_id недоступен."
    },
    "spacer": {
      "purpose_ru": "Пустое пространство для отступов и выравнивания."
    },
    "menu": {
      "purpose_ru": "Контейнер пунктов меню; дочерние — через nrel_ui_contains."
    },
    "menu_bar": {
      "purpose_ru": "Горизонтальная строка меню для пунктов concept_ui_menu_item."
    },
    "list": {
      "purpose_ru": "Набор элементов; включается через nrel_ui_contains."
    },
    "scroll": {
      "purpose_ru": "Контейнер с прокруткой содержимого."
    },
    "window": {
      "purpose_ru": "Оконный контейнер для компонентов интерфейса."
    },
    "text_field": {
      "purpose_ru": "Однострочный ввод текста, значение в text_value."
    },
    "text_area": {
      "purpose_ru": "Многострочный ввод текста, значение в text_value."
    },
    "slider": {
      "purpose_ru": "Числовое значение в text_value; границы не заданы."
    },
    "select": {
      "purpose_ru": "Выбор одного значения из набора."
    },
    "button": {
      "purpose_ru": "Кнопка инициирует действие; текст в text_value, действие в action_id."
    },
    "menu_item": {
      "purpose_ru": "Пункт внутри concept_ui_menu или concept_ui_menu_bar, включается через nrel_ui_contains."
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "default": null,
      "default_note_ru": "по типу",
      "meaning_ru": "Имя компонента в редакторе."
    },
    "x": {
      "type": "number",
      "default": 24,
      "meaning_ru": "Координата X левого верхнего угла."
    },
    "y": {
      "type": "number",
      "default": 24,
      "meaning_ru": "Координата Y левого верхнего угла."
    },
    "width": {
      "type": "number",
      "default": null,
      "default_note_ru": "по типу",
      "meaning_ru": "Ширина в пикселях."
    },
    "height": {
      "type": "number",
      "default": null,
      "default_note_ru": "по типу",
      "meaning_ru": "Высота в пикселях."
    },
    "order": {
      "type": "number",
      "default": 1,
      "meaning_ru": "Порядок слоя: больше — выше."
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "meaning_ru": "Видимость в представлении."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "meaning_ru": "Доступность; false — неактивен."
    },
    "opacity": {
      "type": "number",
      "default": 1,
      "allowed_values": "0…1",
      "meaning_ru": "Непрозрачность: 0 — прозрачный, 1 — нет."
    },
    "text_value": {
      "type": "string",
      "default": "",
      "meaning_ru": "Текст; у image и sound — ресурс."
    },
    "tooltip": {
      "type": "string",
      "default": "",
      "meaning_ru": "Подсказка при наведении."
    },
    "action_id": {
      "type": "string",
      "default": "",
      "meaning_ru": "Идентификатор действия; только у источников действий."
    },
    "background_color": {
      "type": "color",
      "default": "#f4f4f4",
      "default_note_ru": "зависит от типа",
      "meaning_ru": "Цвет фона (CSS)."
    },
    "color": {
      "type": "color",
      "default": "#1a1a1a",
      "meaning_ru": "Цвет текста (CSS)."
    },
    "border_color": {
      "type": "color",
      "default": "#6f6f6f",
      "meaning_ru": "Цвет рамки (CSS)."
    },
    "border_width": {
      "type": "number",
      "default": 1,
      "meaning_ru": "Толщина рамки, px."
    },
    "border_style": {
      "type": "enum",
      "default": "solid",
      "allowed_values": [
        "solid",
        "dashed",
        "none"
      ],
      "meaning_ru": "Стиль рамки."
    },
    "corner_radius": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Радиус скругления, px."
    },
    "font_size": {
      "type": "number",
      "default": 13,
      "meaning_ru": "Размер текста, px."
    },
    "font_weight": {
      "type": "enum",
      "default": "normal",
      "allowed_values": [
        "normal",
        "bold"
      ],
      "meaning_ru": "Насыщенность шрифта."
    },
    "text_align": {
      "type": "enum",
      "default": "left",
      "allowed_values": [
        "left",
        "center",
        "right"
      ],
      "meaning_ru": "Выравнивание текста."
    },
    "padding": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Внутренний отступ."
    },
    "margin": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Внешний отступ."
    },
    "min_width": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Минимальная ширина."
    },
    "min_height": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Минимальная высота."
    },
    "max_width": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Максимальная ширина."
    },
    "max_height": {
      "type": "number",
      "default": 0,
      "meaning_ru": "Максимальная высота."
    }
  },
  "relations": {
    "nrel_ui_contains": "Вложенность: интерфейс → корневые, компонент → дочерний; задаёт структуру, а не плоский список.",
    "nrel_ui_input_target": "Связь действия: триггер → откуда читать данные.",
    "nrel_ui_output_target": "Связь действия: триггер → куда писать результат.",
    "nrel_ui_has_component": "Плоский состав: интерфейс → все компоненты, включая вложенные.",
    "nrel_ui_id": "Строковый идентификатор интерфейса или компонента; значение хранится в sc-link.",
    "nrel_ui_value": "Значение свойства компонента или текст сообщения диалога; значение хранится в sc-link."
  }
}
