# --- LLM ---
LLM_BACKEND=ollama                 # ollama | openai
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=                       # пусто для локального Ollama
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_THINK=false
LLM_KEEP_ALIVE=30m
# Интерактивный таймаут: меньше 30 с, которые ждёт предпросмотр редактора.
LLM_TIMEOUT_S=25
# Клиент ждёт дольше, чем генерирует LLM (strict > LLM_TIMEOUT_S).
DIALOG_CLIENT_TIMEOUT_S=35
# Клиентский таймаут ожидания в миллисекундах (чтение import.meta.env в панели).
VITE_DIALOG_CLIENT_TIMEOUT_S=35000
# Отдельный таймаут для eval-прогонов (tools/run_eval.py).
LLM_TIMEOUT_S_BATCH=120
# Лимит вывода: часть OpenAI-совместимых API ожидает max_tokens,
# часть — max_completion_tokens. Бэкенд пробует первый и откатывается ко второму.
LLM_MAX_OUTPUT_TOKENS=512
# Бюджеты промпта: знания / история / экземпляр / резерв вывода.
# Сумма не должна превышать LLM_NUM_CTX (по умолчанию 6312 из 8192).
KNOWLEDGE_TOKEN_BUDGET=3500
HISTORY_TOKEN_BUDGET=800
INSTANCE_TOKEN_BUDGET=1500
OUTPUT_RESERVE_TOKENS=512

# --- Обработка диалога (B0-1/B0-2) ---
# 1–2 воркера генерации; очередь ограничена, при переполнении — код busy.
DIALOG_WORKER_THREADS=1
DIALOG_QUEUE_SIZE=16
# Последние сообщения диалога в промпте (0 выключает историю); не долговременная память.
DIALOG_HISTORY_TURNS=6
# Аренда единственного экземпляра: heartbeat и допустимое протухание.
SERVICE_HEARTBEAT_INTERVAL_S=5
SERVICE_LEASE_TTL_S=20
WATCHDOG_MAX_AGE_MINUTES=30

# --- OSTIS ---
SC_WS_URL=ws://127.0.0.1:8090/ws_json
ASSISTANT_TRANSPORT=sc-memory      # sc-memory | direct-http
KNOWLEDGE_SOURCE=kb                # kb | fallback (fallback только для отладки)
KB_FALLBACK_ALLOWED=true

# --- Сервис ---
API_HOST=127.0.0.1
API_PORT=8770
LOG_LEVEL=INFO
PROMPT_VERSION=v5
