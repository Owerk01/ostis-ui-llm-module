// Сведения об устройстве инструментальной среды (проект, раздел 7). Тексты сжаты.
// Класс concept_ui_environment_note объявлен в ui_dialog.scs.

ui_env_tool_modules
<- concept_ui_environment_note;
=> nrel_main_idtf: [Модули инструментальной среды] (* <- lang_ru;; *);
=> nrel_ui_knowledge_text: [Модуль ПИ (диалог, визуальный редактор, предпросмотр), модуль решателя задач и модуль базы знаний.];
=> nrel_ui_knowledge_source: [Проект, 7.1];;

ui_env_solver_modules
<- concept_ui_environment_note;
=> nrel_main_idtf: [Модули решателя задач] (* <- lang_ru;; *);
=> nrel_ui_knowledge_text: [Интерпретация запросов, построение, изменение, проверка интерфейса и передача знаний.];
=> nrel_ui_knowledge_source: [Проект, 7.1];;

ui_env_kb_module
<- concept_ui_environment_note;
=> nrel_main_idtf: [База знаний как посредник] (* <- lang_ru;; *);
=> nrel_ui_knowledge_text: [Единое хранилище требований, моделей, правил, версий и журнала; модуль ПИ и решатель задач взаимодействуют только через неё.];
=> nrel_ui_knowledge_source: [Проект, 7.1];;

ui_env_target_system
<- concept_ui_environment_note;
=> nrel_main_idtf: [Целевая система и адаптация] (* <- lang_ru;; *);
=> nrel_ui_knowledge_text: [Модуль ПИ исполняет и изменяет интерфейс; адаптацию выполняют модули сбора, модели пользователя, решения и формирования изменения.];
=> nrel_ui_knowledge_source: [Проект, 7.2–7.4];;
